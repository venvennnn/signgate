# Optional. When set, SignGate uses Foxit OCR, Extraction, Document
# Generation, Combine, HTML→PDF, and eSign after the gate opens.
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# Optional. Pass 1 maps Foxit text to Intent Manifest JSON.
# Python Pass 2 still decides the gate. The model cannot open it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
