# Optional. When set, SignGate uses Foxit PDF Services for HTML→PDF,
# merge, and text extraction, and Foxit eSign after the gate opens.
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# Optional. LLM proposes semantic findings only. Deterministic rules
# and human approval still control the signature gate.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
